# ScoutForge Backend Environment Configuration
PROJECT_NAME="ScoutForge"
SECRET_KEY="scoutforge-dev-secret-key-change-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./scoutforge.db"

# Telemetry APIs
PANDASCORE_API_KEY="your_pandascore_api_key_here"
LEETIFY_API_KEY="your_leetify_api_key_here"

# Audio & Speech AI
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cuda"
UPLOAD_DIR="./uploads"

# Dual-AI 70/30 Evaluator (Groq Primary + Gemini Fallback)
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# CORS
CORS_ORIGINS="http://localhost:3000"
